# GitHub OAuth App credentials (GitHub → Settings → Developer settings →
# OAuth Apps). Callback URL: <app-url>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to use the dashboard.
# Empty = any authenticated GitHub user can sign in.
ALLOWED_USERS=

# Local run port (Vercel sets PORT at runtime)
PORT=8080
